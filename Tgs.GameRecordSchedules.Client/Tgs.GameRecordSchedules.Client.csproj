<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net7.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<Version>0.0.11</Version>
		<Authors>Raypro</Authors>
		<Description>Tgs GameRecordSchedules Client</Description>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-gamerecordschedules</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-gamerecordschedules.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Tgs GameRecordSchedules</PackageTags>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Protos\**" />
	  <EmbeddedResource Remove="Protos\**" />
	  <None Remove="Protos\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.59.0" />
		<PackageReference Include="Grpc.Net.ClientFactory" Version="2.59.0" />
		<PackageReference Include="Grpc.Tools" Version="2.59.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
	</ItemGroup>

	<ItemGroup>
	  <Protobuf Include="..\Tgs.GameRecordSchedules\Protos\gamerecordschedules.proto" GrpcServices="Client">
	    <Link>gamerecordschedules.proto</Link>
	  </Protobuf>
	  <Protobuf Include="..\Tgs.GameRecordSchedules\Protos\sabagamerecordschedules.proto" GrpcServices="Client">
	    <Link>sabagamerecordschedules.proto</Link>
	  </Protobuf>
	</ItemGroup>

</Project>
