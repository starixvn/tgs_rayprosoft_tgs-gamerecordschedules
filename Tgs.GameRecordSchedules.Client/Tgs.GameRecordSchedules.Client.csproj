<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<Version>0.0.12</Version>
		<Authors>Raypro</Authors>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-gamerecordschedules</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-gamerecordschedules.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<RootNamespace>Tgs.GameRecordSchedules.Client</RootNamespace>
		<PackageId>Tgs.GameRecordSchedules.Client</PackageId>
		<Title>Tgs.GameRecordSchedules.Client</Title>
		<Description>Tgs.GameRecordSchedules.Client</Description>
		<PackageTags>Tgs GameRecordSchedules Client</PackageTags>
	</PropertyGroup>
	
	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.60.0" />
		<PackageReference Include="Grpc.Net.ClientFactory" Version="2.60.0" />
		<PackageReference Include="Grpc.Tools" Version="2.60.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
	</ItemGroup>

	<ItemGroup>
	  <Protobuf Include="..\Tgs.GameRecordSchedules\Protos\gamerecordschedules.proto" GrpcServices="Client">
	    <Link>gamerecordschedules.proto</Link>
	  </Protobuf>
	  <Protobuf Include="..\Tgs.GameRecordSchedules\Protos\sabagamerecordschedules.proto" GrpcServices="Client">
	    <Link>sabagamerecordschedules.proto</Link>
	  </Protobuf>
	</ItemGroup>

</Project>
